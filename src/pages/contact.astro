---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="お問い合わせ"
  description="psipsinaへのお問い合わせ。キャンセル・住所変更・その他ご連絡はこちらから。"
>
  <section class="section">
    <div class="container">
      <span class="section-label">contact</span>
      <h1 class="page-title">お問い合わせ</h1>
      <p class="page-lead">
        キャンセル・住所変更・その他のご連絡はこちらのフォームからお送りください。
      </p>
      <div class="form-wrap">
        <iframe
          src="https://tally.so/r/Bz8LDe"
          width="100%"
          height="800"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="お問い合わせフォーム"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-weight: 400;
    font-size: var(--text-xl);
    letter-spacing: 0.05em;
    margin-bottom: var(--sp-3);
  }
  .page-lead {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 2;
    margin-bottom: var(--sp-6);
    max-width: 480px;
  }
  .form-wrap {
    border-top: 1px solid var(--color-border);
    padding-top: var(--sp-5);
  }
</style>