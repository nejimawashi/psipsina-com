---
// contact.astro — お問い合わせページ
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="お問い合わせ"
  description="psipsinaへのお問い合わせ。キャンセル・住所変更・その他ご連絡はこちらから。"
>

  <section class="section">
    <div class="container">
      <span class="section-label">contact</span>
      <h1 class="page-title">お問い合わせ</h1>
      <p class="page-lead">
        キャンセル・住所変更・その他のご連絡はこちらのフォームからお送りください。<br />
        背景色が黒になっている場合がありますが、問い合わせは問題なくできます。
      </p>
      <div class="form-wrap">
        <iframe
          style="border:none; width:100%;"
          height="900px"
          src="https://nejimawashi.notion.site/ebd/1d31e8f9100a802fac0ac56b9f82360f"
          title="お問い合わせフォーム"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-title {
    font-weight: 400;
    font-size: var(--text-xl);
    letter-spacing: 0.05em;
    margin-bottom: var(--sp-3);
  }

  .page-lead {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 2;
    margin-bottom: var(--sp-6);
    max-width: 480px;
  }

  .form-wrap {
    border-top: 1px solid var(--color-border);
    padding-top: var(--sp-5);
  }
</style>
