---
// src/components/mdx/Grid.astro
//
// 【使い方】
// <Grid>
//   ![写真1](/images/01.jpg)
//   ![写真2](/images/02.jpg)
//   ![写真3](/images/03.jpg)
// </Grid>
//
// <Grid cols={2}>
//   ![写真1](/images/01.jpg)
//   ![写真2](/images/02.jpg)
// </Grid>
//
// 【colsの種類】
// 2 : 2列（デフォルト）
// 3 : 3列
// ※ スマホでは自動的に1列になります

interface Props {
  cols?: 2 | 3;
  gap?: 'none' | 'sm' | 'md';
}

const { cols = 2, gap = 'sm' } = Astro.props;
---

<div class={`grid grid--${cols} grid--gap-${gap}`}>
  <slot />
</div>

<style>
  .grid {
    display: grid;
    margin: var(--sp-5) 0;
  }

  .grid--2 { grid-template-columns: repeat(2, 1fr); }
  .grid--3 { grid-template-columns: repeat(3, 1fr); }

  .grid--gap-none { gap: 0; }
  .grid--gap-sm   { gap: 2px; }
  .grid--gap-md   { gap: var(--sp-3); }

  /* 画像をグリッド内でそろえる */
  .grid :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  /* gap-md のときは縦横比を自由に */
  .grid--gap-md :global(img) {
    aspect-ratio: auto;
    max-height: 400px;
  }

  @media (max-width: 500px) {
    .grid--2,
    .grid--3 { grid-template-columns: 1fr; }
  }
</style>
