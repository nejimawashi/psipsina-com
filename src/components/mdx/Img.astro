---
// src/components/mdx/Img.astro
//
// 【使い方】
// <Img src="/images/photo.jpg" alt="説明" />
// <Img src="/images/photo.jpg" alt="説明" size="lg" />
// <Img src="/images/photo.jpg" alt="説明" size="full" />
//
// 【sizeの種類】
// sm   : 最大320px幅（小さめ）
// md   : 最大480px幅（デフォルト）
// lg   : 最大720px幅（大きめ）
// full : 画面幅いっぱい（セクション幅を超えて広がる）

interface Props {
  src: string;
  alt?: string;
  size?: 'sm' | 'md' | 'lg' | 'full';
  caption?: string;
}

const { src, alt = '', size = 'md', caption } = Astro.props;
---

<figure class={`img img--${size}`}>
  <img src={src} alt={alt} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .img {
    margin: var(--sp-5) 0;
  }

  .img img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* サイズ */
  .img--sm  { max-width: 320px; }
  .img--md  { max-width: 480px; }
  .img--lg  { max-width: 100%; }

  /* full: コンテナ幅を突き破って広がる */
  .img--full {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    max-width: none;
  }
  .img--full img {
    max-height: 560px;
    object-fit: cover;
  }

  figcaption {
    margin-top: var(--sp-1);
    font-size: var(--text-xs);
    color: var(--color-muted);
    letter-spacing: 0.1em;
  }
</style>
