---
// LegalTable.astro — 特定商取引法テーブル用コンポーネント
// 使い方（MDXから）:
//   <LegalTable items={[
//     { label: "販売業者", value: "psipsina" },
//     { label: "所在地", value: "神奈川県茅ヶ崎市（詳細はお問い合わせください）" },
//   ]} />
//
// リンクを含む場合は valueHtml を使う:
//   { label: "お問い合わせ", valueHtml: '<a href="/contact">お問い合わせフォーム</a>よりご連絡ください' }

interface Item {
  label: string;
  value?: string;
  valueHtml?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<dl class="legal-table">
  {items.map((item) => (
    <div class="legal-table__row">
      <dt>{item.label}</dt>
      <dd>
        {item.valueHtml
          ? <Fragment set:html={item.valueHtml} />
          : item.value
        }
      </dd>
    </div>
  ))}
</dl>

<style>
  .legal-table {
    border-top: 1px solid var(--color-border);
  }

  .legal-table__row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--sp-3);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
  }

  @media (max-width: 500px) {
    .legal-table__row {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }

  dt {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  dd {
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  dd :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  dd :global(a:hover) {
    color: var(--color-muted);
  }
</style>
