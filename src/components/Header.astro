---
// Header.astro — psipsina
// ハンバーガーナビゲーション
---

<header class="nav" id="nav">
  <a href="/" class="nav__logo">psipsina</a>
  <button class="nav__burger" id="burger" aria-label="メニューを開く">
    <span></span>
    <span></span>
    <span></span>
  </button>
</header>

<!-- Drawer -->
<div class="nav__drawer" id="drawer" aria-hidden="true">
  <nav>
    <span class="drawer-label">menu</span>
    <a href="/#notice">お知らせ</a>
    <a href="/#message">メッセージ</a>
    <a href="/#bread">psipsinaのパン</a>
    <a href="/#shop">通販</a>
    <a href="/contact">お問い合わせ</a>
  </nav>
</div>
<div class="nav__overlay" id="overlay"></div>

<style>
  /* ── Nav bar ── */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--sp-4);
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .nav.scrolled {
    border-bottom-color: var(--color-border);
  }

  .nav__logo {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-sm);
    letter-spacing: 0.3em;
    text-transform: lowercase;
    text-decoration: none;
    color: var(--color-text);
  }

  /* ── Hamburger ── */
  .nav__burger {
    width: 32px;
    height: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .nav__burger span {
    display: block;
    height: 1px;
    background: var(--color-text);
    transition:
      transform var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
    transform-origin: center;
  }

  .nav__burger.open span:nth-child(1) {
    transform: translateY(9.5px) rotate(45deg);
  }
  .nav__burger.open span:nth-child(2) {
    opacity: 0;
  }
  .nav__burger.open span:nth-child(3) {
    transform: translateY(-9.5px) rotate(-45deg);
  }

  /* ── Drawer ── */
  .nav__drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 280px;
    height: 100vh;
    background: var(--color-bg-dark);
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--sp-8) var(--sp-6);
    transform: translateX(100%);
    transition: transform 0.45s var(--ease);
    z-index: 99;
  }

  .nav__drawer.open {
    transform: translateX(0);
  }

  .nav__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease);
    z-index: 98;
  }

  .nav__overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  .nav__drawer nav {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .nav__drawer a {
    font-size: var(--text-sm);
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color var(--dur);
  }

  .nav__drawer a:hover {
    color: #fff;
  }

  .drawer-label {
    font-size: var(--text-xs);
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.3);
    text-transform: uppercase;
    margin-bottom: var(--sp-2);
  }
</style>

<script>
  const nav     = document.getElementById('nav')!;
  const burger  = document.getElementById('burger')!;
  const drawer  = document.getElementById('drawer')!;
  const overlay = document.getElementById('overlay')!;

  // Scroll → border
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  // Toggle helper
  function toggleMenu(open: boolean) {
    burger.classList.toggle('open', open);
    drawer.classList.toggle('open', open);
    overlay.classList.toggle('open', open);
    drawer.setAttribute('aria-hidden', String(!open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  burger.addEventListener('click', () =>
    toggleMenu(!drawer.classList.contains('open'))
  );
  overlay.addEventListener('click', () => toggleMenu(false));
  drawer.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => toggleMenu(false))
  );
</script>
